LOG_ARITHMIC_HOST=127.0.0.1
LOG_ARITHMIC_PORT=8787
LOG_ARITHMIC_DATABASE=./data/log-arithmic.sqlite
# Optional for local development: when unset, a random token is saved beside the database.
LOG_ARITHMIC_ADMIN_TOKEN=
LOG_ARITHMIC_RETENTION_DAYS=30
LOG_ARITHMIC_CORS_ORIGIN=http://localhost:5173
LOG_ARITHMIC_RATE_LIMIT=120
LOG_ARITHMIC_MAX_BATCH_SIZE=500
LOG_ARITHMIC_MAX_REQUEST_BYTES=1048576
